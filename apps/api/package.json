{
  "name": "@routiq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "tsx --test --test-isolation=none tests/zte.parser.test.ts tests/api.routes.test.ts",
    "smoke:router": "tsx scripts/router-smoke.ts",
    "audit:router": "tsx scripts/zte-endpoint-audit.ts",
    "probe:router": "tsx scripts/zte-readonly-probe.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
